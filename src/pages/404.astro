---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
---
<BaseLayout title="Page not found | Zona Homes Services" description="This page could not be found." path="/404/" noindex hasQuote={false}>
  <section class="center-page">
    <div class="wrap">
      <h1>We could not find that page</h1>
      <p>The link may be old or mistyped. You can go back to the home page, see our services or call us.</p>
      <div class="btn-row">
        <a class="btn btn-gold" href={`tel:${SITE.phoneTel}`}><Icon name="phone" />Call {SITE.phoneDisplay}</a>
        <a class="btn btn-line" href="/">Home page</a>
        <a class="btn btn-line" href="/services/">Our services</a>
      </div>
    </div>
  </section>
</BaseLayout>
